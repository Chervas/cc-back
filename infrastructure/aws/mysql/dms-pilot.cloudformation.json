{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "REVIEW ONLY: 24-hour synthetic MySQL DMS pilot. Creates no database users, no source listener and never starts replication. Needs CAPABILITY_NAMED_IAM for the previously absent dms-vpc-role.",
  "Metadata": {
    "Scope": "Only cc_dms_pilot fictional data. Clinical/DEV accounts and schemas prohibited.",
    "CostBudget": "Review estimate USD10-15/24h; no automatic deletion/budget enforcement. Stop/delete pilot promptly.",
    "RequiredPreflight": [
      "Check dms-vpc-role is still absent before creating this stack; never replace an existing role.",
      "Existing subnets must be private, in this VPC, distinct AZs, with peering route to 172.26.0.0/16.",
      "Create fictional source/target users later from these generated secrets in memory, restricted to cc_dms_pilot.",
      "Source certificate must verify 172.26.0.110 as an IP SAN; prove wrong-CA and wrong-name rejection.",
      "Endpoint schema mappings, generated-column exclusions, cascades and LOB handling must be rehearsed before a clinical plan.",
      "Retained secrets and shared VPC role require explicit cleanup after confirming no consumers; no secret values are outputs."
    ],
    "PublicRdsCaSource": "https://truststore.pki.rds.amazonaws.com/eu-west-3/eu-west-3-bundle.pem",
    "PublicRdsCaSha256": "6f2e2f0cabeed0e40f7cc432e47be1ff7a4b6faa28318fb2a9e060afdee5bc26"
  },
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Exactly the existing private RDS subnets across at least two AZs."
    },
    "TargetRdsSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "TargetRdsHostname": {
      "Type": "String",
      "AllowedPattern": "^[a-zA-Z0-9.-]+\\.eu-west-3\\.rds\\.amazonaws\\.com$",
      "Description": "Exact RDS DNS endpoint for hostname verification; never its IP."
    },
    "DmsEngineVersion": {
      "Type": "String",
      "AllowedPattern": "^3\\.(5\\.([4-9]|[1-9][0-9]+)|([6-9]|[1-9][0-9]+)\\.[0-9]+)$",
      "Description": "3.6.1 recommended after regional orderability check; exact version >=3.5.4 is still explicit.",
      "Default": "3.6.1"
    },
    "PilotSourceCaPem": {
      "Type": "String",
      "MinLength": 256,
      "MaxLength": 4096,
      "AllowedPattern": "(?s)^-----BEGIN CERTIFICATE-----\\s+[A-Za-z0-9+/=\\r\\n]+-----END CERTIFICATE-----\\s*$",
      "Description": "PUBLIC pilot CA PEM only, not a private key or clinical credentials."
    },
    "CreatePilotTask": {
      "Type": "String",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Default": "false",
      "Description": "Creates an idle task only; leave false until synthetic users/TLS/connections are verified."
    },
    "PilotIdentityConfirmed": {
      "Type": "String",
      "AllowedValues": [
        "no",
        "synthetic-only-confirmed"
      ],
      "Default": "no"
    }
  },
  "Conditions": {
    "CreateTask": {
      "Fn::Equals": [
        {
          "Ref": "CreatePilotTask"
        },
        "true"
      ]
    }
  },
  "Rules": {
    "TaskRequiresSyntheticIdentity": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "CreatePilotTask"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "PilotIdentityConfirmed"
              },
              "synthetic-only-confirmed"
            ]
          },
          "AssertDescription": "Only the independently verified isolated fictional source and target may be selected."
        }
      ]
    }
  },
  "Resources": {
    "DmsVpcRole": {
      "Type": "AWS::IAM::Role",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RoleName": "dms-vpc-role",
        "Description": "Created only after an explicit absence check; retain until no DMS consumer depends on it.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "dms.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonDMSVPCManagementRole"
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "PilotSourceSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Synthetic MySQL endpoint account only; not the RDS administrator.",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"cc_dms_pilot\",\"host\":\"172.26.0.110\",\"port\":23306,\"dbname\":\"cc_dms_pilot\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "PilotTargetSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Synthetic MySQL endpoint account only; not the RDS administrator.",
        "GenerateSecretString": {
          "SecretStringTemplate": {
            "Fn::Sub": "{\"username\":\"cc_dms_pilot\",\"host\":\"${TargetRdsHostname}\",\"port\":3306,\"dbname\":\"cc_dms_pilot\"}"
          },
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "DmsSecretAccessRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Read only this stack synthetic endpoint secrets using the documented regional DMS principal.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "dms.${AWS::Region}.amazonaws.com"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReadOwnPilotSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "PilotSourceSecret"
                    },
                    {
                      "Ref": "PilotTargetSecret"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "DmsSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "Private synthetic DMS only",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 9,
            "ToPort": 9,
            "CidrIp": "127.0.0.1/32",
            "Description": "Suppress default allow-all outbound; loopback discard only"
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "SecretsEndpointSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "Private Secrets Manager endpoint only",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 9,
            "ToPort": 9,
            "CidrIp": "127.0.0.1/32",
            "Description": "Suppress default allow-all outbound; loopback discard only"
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "DmsToSource": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "DmsSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 23306,
        "ToPort": 23306,
        "CidrIp": "172.26.0.110/32",
        "Description": "Dedicated fictional mysqld passthrough only; never clinical port 13306/3306"
      }
    },
    "DmsToTarget": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "DmsSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "DestinationSecurityGroupId": {
          "Ref": "TargetRdsSecurityGroupId"
        }
      }
    },
    "TargetFromDms": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TargetRdsSecurityGroupId"
        },
        "IpProtocol": "tcp",
        "FromPort": 3306,
        "ToPort": 3306,
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "DmsSecurityGroup",
            "GroupId"
          ]
        },
        "Description": "Temporary synthetic DMS account and schema only"
      }
    },
    "DmsToSecretsEndpoint": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "DmsSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": [
            "SecretsEndpointSecurityGroup",
            "GroupId"
          ]
        }
      }
    },
    "SecretsEndpointFromDms": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "SecretsEndpointSecurityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443,
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "DmsSecurityGroup",
            "GroupId"
          ]
        }
      }
    },
    "SecretsManagerVpcEndpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "VpcEndpointType": "Interface",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.secretsmanager"
        },
        "PrivateDnsEnabled": true,
        "SubnetIds": {
          "Ref": "PrivateSubnetIds"
        },
        "SecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "SecretsEndpointSecurityGroup",
              "GroupId"
            ]
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "DmsSecretAccessRole",
                    "Arn"
                  ]
                }
              },
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": [
                {
                  "Ref": "PilotSourceSecret"
                },
                {
                  "Ref": "PilotTargetSecret"
                }
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "DmsSubnetGroup": {
      "Type": "AWS::DMS::ReplicationSubnetGroup",
      "Properties": {
        "ReplicationSubnetGroupDescription": "Existing two private RDS subnets only; no Internet/NAT routes created.",
        "SubnetIds": {
          "Ref": "PrivateSubnetIds"
        },
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "ReplicationInstance": {
      "Type": "AWS::DMS::ReplicationInstance",
      "DependsOn": [
        "DmsVpcRole",
        "SecretsManagerVpcEndpoint",
        "DmsToSource",
        "DmsToTarget",
        "TargetFromDms",
        "DmsToSecretsEndpoint",
        "SecretsEndpointFromDms"
      ],
      "Properties": {
        "ReplicationInstanceClass": "dms.r6i.large",
        "AllocatedStorage": 50,
        "MultiAZ": false,
        "PubliclyAccessible": false,
        "AutoMinorVersionUpgrade": true,
        "AllowMajorVersionUpgrade": false,
        "EngineVersion": {
          "Ref": "DmsEngineVersion"
        },
        "ReplicationSubnetGroupIdentifier": {
          "Ref": "DmsSubnetGroup"
        },
        "VpcSecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "DmsSecurityGroup",
              "GroupId"
            ]
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    },
    "PilotSourceCertificate": {
      "Type": "AWS::DMS::Certificate",
      "Properties": {
        "CertificatePem": {
          "Ref": "PilotSourceCaPem"
        }
      }
    },
