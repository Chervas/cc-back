    "SourceEndpoint": {
      "Type": "AWS::DMS::Endpoint",
      "DependsOn": [
        "SecretsManagerVpcEndpoint"
      ],
      "Properties": {
        "EndpointType": "source",
        "EngineName": "mysql",
        "SslMode": "verify-full",
        "CertificateArn": {
          "Ref": "PilotSourceCertificate"
        },
        "MySqlSettings": {
          "SecretsManagerSecretId": {
            "Ref": "PilotSourceSecret"
          },
          "SecretsManagerAccessRoleArn": {
            "Fn::GetAtt": [
              "DmsSecretAccessRole",
              "Arn"
            ]
          }
        },
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ],
        "ExtraConnectionAttributes": {
          "Fn::Sub": [
            "secretsManagerEndpointOverride=${SecretsManagerEndpointDns};",
            {
              "SecretsManagerEndpointDns": {
                "Fn::Select": [
                  1,
                  {
                    "Fn::Split": [
                      ":",
                      {
                        "Fn::Select": [
                          0,
                          {
                            "Fn::GetAtt": [
                              "SecretsManagerVpcEndpoint",
                              "DnsEntries"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "TargetEndpoint": {
      "Type": "AWS::DMS::Endpoint",
      "DependsOn": [
        "SecretsManagerVpcEndpoint"
      ],
      "Properties": {
        "EndpointType": "target",
        "EngineName": "mysql",
        "SslMode": "verify-full",
        "CertificateArn": {
          "Ref": "RdsTargetCertificate"
        },
        "MySqlSettings": {
          "SecretsManagerSecretId": {
            "Ref": "PilotTargetSecret"
          },
          "SecretsManagerAccessRoleArn": {
            "Fn::GetAtt": [
              "DmsSecretAccessRole",
              "Arn"
            ]
          }
        },
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ],
        "ExtraConnectionAttributes": {
          "Fn::Sub": [
            "Initstmt=SET FOREIGN_KEY_CHECKS=0;secretsManagerEndpointOverride=${SecretsManagerEndpointDns};",
            {
              "SecretsManagerEndpointDns": {
                "Fn::Select": [
                  1,
                  {
                    "Fn::Split": [
                      ":",
                      {
                        "Fn::Select": [
                          0,
                          {
                            "Fn::GetAtt": [
                              "SecretsManagerVpcEndpoint",
                              "DnsEntries"
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "PilotTask": {
      "Type": "AWS::DMS::ReplicationTask",
      "Condition": "CreateTask",
      "Properties": {
        "MigrationType": "full-load-and-cdc",
        "ReplicationInstanceArn": {
          "Ref": "ReplicationInstance"
        },
        "SourceEndpointArn": {
          "Ref": "SourceEndpoint"
        },
        "TargetEndpointArn": {
          "Ref": "TargetEndpoint"
        },
        "TableMappings": "{\"rules\":[{\"rule-type\":\"selection\",\"rule-id\":\"1\",\"rule-name\":\"synthetic-only\",\"object-locator\":{\"schema-name\":\"cc_dms_pilot\",\"table-name\":\"%\"},\"rule-action\":\"include\"}]}",
        "ReplicationTaskSettings": "{\"TargetMetadata\":{\"TargetSchema\":\"\",\"SupportLobs\":true,\"FullLobMode\":true,\"LobChunkSize\":64,\"LimitedSizeLobMode\":false,\"InlineLobMaxSize\":0,\"BatchApplyEnabled\":false},\"FullLoadSettings\":{\"TargetTablePrepMode\":\"DO_NOTHING\",\"CreatePkAfterFullLoad\":false,\"MaxFullLoadSubTasks\":2,\"CommitRate\":1000,\"TransactionConsistencyTimeout\":60,\"StopTaskCachedChangesApplied\":true,\"StopTaskCachedChangesNotApplied\":false},\"ValidationSettings\":{\"EnableValidation\":true,\"ValidationOnly\":false,\"ThreadCount\":2,\"SkipLobColumns\":false,\"ValidationPartialLobSize\":0},\"ErrorBehavior\":{\"DataErrorPolicy\":\"STOP_TASK\",\"DataTruncationErrorPolicy\":\"STOP_TASK\",\"DataErrorEscalationPolicy\":\"STOP_TASK\",\"TableErrorPolicy\":\"STOP_TASK\",\"ApplyErrorDeletePolicy\":\"STOP_TASK\",\"ApplyErrorInsertPolicy\":\"STOP_TASK\",\"ApplyErrorUpdatePolicy\":\"STOP_TASK\",\"ApplyErrorEscalationPolicy\":\"STOP_TASK\",\"FullLoadIgnoreConflicts\":false,\"FailOnNoTablesCaptured\":true,\"FailOnTransactionConsistencyBreached\":true},\"Logging\":{\"EnableLogging\":false}}",
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          }
        ]
      }
    }
  },
