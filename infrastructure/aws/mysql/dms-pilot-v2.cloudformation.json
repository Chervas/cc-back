    "DmsCloudWatchLogsRole": {
      "Type": "AWS::IAM::Role",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "RoleName": "dms-cloudwatch-logs-role",
        "Description": "V2 synthetic pilot only; create solely after a fresh absence check, never adopt a shared role.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "dms.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "WriteOwnSyntheticPilotLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "DescribeLogGroups",
                  "Effect": "Allow",
                  "Action": [
                    "logs:DescribeLogGroups"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "OwnPilotGroup",
                  "Effect": "Allow",
                  "Action": [
                    "logs:DescribeLogStreams",
                    "logs:CreateLogGroup"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:dms-tasks-${PilotV2Identifier}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:dms-tasks-${PilotV2Identifier}:*"
                    }
                  ]
                },
                {
                  "Sid": "OwnPilotTaskStreams",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:dms-tasks-${PilotV2Identifier}:log-stream:dms-task-*"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          },
          {
            "Key": "pilot-version",
            "Value": "v2"
          }
        ]
      }
    }
  },
  "Outputs": {
    "ReplicationInstanceArn": {
      "Value": {
        "Ref": "ReplicationInstance"
      }
    },
    "PilotSourceSecretArn": {
      "Value": {
        "Ref": "PilotSourceSecret"
      }
    },
    "PilotTargetSecretArn": {
      "Value": {
        "Ref": "PilotTargetSecret"
      }
    },
    "SourceEndpointArn": {
      "Value": {
        "Ref": "SourceEndpoint"
      }
    },
    "TargetEndpointArn": {
      "Value": {
        "Ref": "TargetEndpoint"
      }
    },
    "SecretsManagerVpcEndpointId": {
      "Value": {
        "Ref": "SecretsManagerVpcEndpoint"
      }
    },
    "DmsSecurityGroupId": {
      "Value": {
        "Fn::GetAtt": [
          "DmsSecurityGroup",
          "GroupId"
        ]
      }
    },
    "PilotTaskArn": {
      "Condition": "CreateTask",
      "Value": {
        "Ref": "PilotTask"
      }
    },
    "PilotLogGroupName": {
      "Value": {
        "Ref": "PilotLogGroup"
      }
    },
    "PilotLogsRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DmsCloudWatchLogsRole",
          "Arn"
        ]
      }
    },
    "PilotV2Identifier": {
      "Value": {
        "Ref": "PilotV2Identifier"
      }
    }
  }
}
