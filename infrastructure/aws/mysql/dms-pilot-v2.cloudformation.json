{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "REVIEW ONLY V2: independent synthetic MySQL native-seed CDC, diagnostic CloudWatch logging, no task start/source/firewall creation. Reuses existing dms-vpc-role; only new named service IAM role is dms-cloudwatch-logs-role.",
  "Metadata": {
    "Scope": "Only new owned cc_dms_pilot synthetic resources; no application/DEV/clinical migration.",
    "BaselineTemplateSha256": "84b672467ce0bfd413dd3efc5318571f24eb60b753225779186b01c4a532a7d8",
    "PreviousPilotStatus": "INCONCLUSIVE: source stopped on unattributed signal; no applied CDC events or restart checkpoint proven.",
    "RequiredPreflight": [
      "Fresh proof that V1 task/instance/endpoints/VPCE/rules are deleted; retained V1 evidence preserved.",
      "Fresh exact-name logs-role absence and reviewed existing dms-vpc-role; no operator-role or permissionset edits.",
      "VPC/subnets/private routes/account/region/CA/orderability verified independently; no NAT or host-network change here.",
      "New source run and native seed receipt; new empty target decision by root; never silently overwrite V1 target.",
      "Root source23306 firewall only fresh V2 DMS private IP; no public or 3306/13306 source opening.",
      "Task starts only after TLS positives/negatives, seed restore and actual log stream delivery; CFN does not start it."
    ],
    "SyntheticNativeSeedCdc": {
      "SourceRunId": {
        "Ref": "SourceRunId"
      },
      "SeedSha256": {
        "Ref": "NativeSeedSha256"
      },
      "CdcStartPosition": {
        "Ref": "CdcStartPosition"
      },
      "Schema": "cc_dms_pilot",
      "ControlSchema": "cc_dms_pilot",
      "AllowedTargetControlTables": [
        "awsdms_apply_exceptions",
        "awsdms_validation_failures_v1"
      ],
      "NativeNotNullFirst": true,
      "TaskCreationIsIdle": true,
      "ClinicalCopyAuthorized": false,
      "AllInheritedGatesPassed": false
    },
    "LoggingScope": "Exact own instance-derived group; all task streams under it. DescribeLogGroups wildcard is read-only API requirement. No serverless resources, log read/delete or operator grants.",
    "LogDeliveryIsNotProvenByIam": true,
    "Cleanup": "Delete own task first, instance, endpoints/certificates/rules/VPCE, own group and own logs role after proving no consumers. Retained generated secrets require explicit owner cleanup; never remove retained VPC role.",
    "PublicRdsCaSource": "https://truststore.pki.rds.amazonaws.com/eu-west-3/eu-west-3-bundle.pem",
    "PublicRdsCaSha256": "6f2e2f0cabeed0e40f7cc432e47be1ff7a4b6faa28318fb2a9e060afdee5bc26"
  },
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "Exactly the existing private RDS subnets across at least two AZs."
    },
    "TargetRdsSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id"
    },
    "TargetRdsHostname": {
      "Type": "String",
      "AllowedPattern": "^[a-zA-Z0-9.-]+\\.eu-west-3\\.rds\\.amazonaws\\.com$",
      "Description": "Exact RDS DNS endpoint for hostname verification; never its IP."
    },
    "DmsEngineVersion": {
      "Type": "String",
      "Description": "3.6.1 recommended after regional orderability check; exact version >=3.5.4 is still explicit.",
      "Default": "3.6.1",
      "AllowedValues": [
        "3.6.1"
      ]
    },
    "CreatePilotTask": {
      "Type": "String",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Default": "false",
      "Description": "Creates an idle task only; leave false until synthetic users/TLS/connections are verified."
    },
    "PilotIdentityConfirmed": {
      "Type": "String",
      "AllowedValues": [
        "no",
        "synthetic-only-confirmed"
      ],
      "Default": "no",
      "Description": "Root must independently verify only the new owned synthetic source/target; not a clinical-copy authorization."
    },
    "OldPilotDeletionConfirmed": {
      "Type": "String",
      "AllowedValues": [
        "no",
        "deleted-and-verified"
      ],
      "Default": "no"
    },
    "CloudWatchLogsRoleAbsenceConfirmed": {
      "Type": "String",
      "AllowedValues": [
        "no",
        "absent-and-verified"
      ],
      "Default": "no"
    },
    "ExistingVpcRoleConfirmed": {
      "Type": "String",
      "AllowedValues": [
        "no",
        "reviewed-and-verified"
      ],
      "Default": "no"
    },
    "PilotV2Identifier": {
      "Type": "String",
      "AllowedPattern": "^cc-mysql-v2-[a-z0-9]{8}$",
      "Description": "Fresh own identifier, <=31 chars; used for instance ARN suffix and CloudWatch group."
    },
    "SourceRunId": {
      "Type": "String",
      "Default": "PENDING",
      "AllowedPattern": "^(PENDING|[0-9a-f]{32})$"
    },
    "NativeSeedSha256": {
      "Type": "String",
      "Default": "PENDING",
      "AllowedPattern": "^(PENDING|[0-9a-f]{64})$"
    },
    "CdcStartPosition": {
      "Type": "String",
      "Default": "PENDING",
      "AllowedPattern": "^(PENDING|pilot-bin\\.[0-9]{6}:[1-9][0-9]*)$"
    }
  },
  "Conditions": {
    "CreateTask": {
      "Fn::Equals": [
        {
          "Ref": "CreatePilotTask"
        },
        "true"
      ]
    }
  },
  "Rules": {
    "TaskRequiresSyntheticIdentity": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "CreatePilotTask"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "PilotIdentityConfirmed"
              },
              "synthetic-only-confirmed"
            ]
          },
          "AssertDescription": "Only the independently verified isolated fictional source and target may be selected."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "SourceRunId"
                  },
                  "PENDING"
                ]
              }
            ]
          },
          "AssertDescription": "SourceRunId must come from the new validated native-seed receipt."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "NativeSeedSha256"
                  },
                  "PENDING"
                ]
              }
            ]
          },
          "AssertDescription": "NativeSeedSha256 must come from the new validated native-seed receipt."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "CdcStartPosition"
                  },
                  "PENDING"
                ]
              }
            ]
          },
          "AssertDescription": "CdcStartPosition must come from the new validated native-seed receipt."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "SourceRunId"
                  },
                  "56b3538248370bf5b52d1b881e07280f"
                ]
              }
            ]
          },
          "AssertDescription": "V1 seed/run must not be reused."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "NativeSeedSha256"
                  },
                  "3746dd145fe1da0a43b92003386b8892e011e7733262bc9f31a1f88fa4d06e07"
                ]
              }
            ]
          },
          "AssertDescription": "V1 seed/run must not be reused."
        }
      ]
    },
    "FreshPilotInfrastructureOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "OldPilotDeletionConfirmed"
              },
              "deleted-and-verified"
            ]
          },
          "AssertDescription": "No new paid pilot before all V1 replication infrastructure is deleted and verified."
        },
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "CloudWatchLogsRoleAbsenceConfirmed"
              },
              "absent-and-verified"
            ]
          },
          "AssertDescription": "Never replace/adopt an existing dms-cloudwatch-logs-role."
        },
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "ExistingVpcRoleConfirmed"
              },
              "reviewed-and-verified"
            ]
          },
          "AssertDescription": "Reuse only the existing reviewed dms-vpc-role; this stack does not modify it."
        }
      ]
    }
  },
  "Resources": {
    "PilotSourceSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Synthetic MySQL endpoint account only; not the RDS administrator.",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"cc_dms_pilot\",\"host\":\"172.26.0.110\",\"port\":23306,\"dbname\":\"cc_dms_pilot\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "application",
            "Value": "clinicaclick"
          },
          {
            "Key": "project",
            "Value": "clinicaclick"
          },
          {
            "Key": "component",
            "Value": "database"
          },
          {
            "Key": "environment",
            "Value": "staging"
          },
          {
            "Key": "owner",
            "Value": "architecture"
          },
          {
            "Key": "purpose",
            "Value": "mysql-synthetic-pilot"
          },
          {
            "Key": "pilot-version",
            "Value": "v2"
          }
        ],
        "Name": {
          "Fn::Sub": "clinicaclick/mysql-pilot-v2/${PilotV2Identifier}/source"
        }
      }
    },
