#!/bin/sh
set -eu
[ "$(id -u cc-wa-importer)" = "997" ] || exit 1
for tool in /usr/sbin/iptables /usr/sbin/ip6tables; do
 "$tool" -w -I OUTPUT 1 -m owner --uid-owner 997 -j REJECT
 "$tool" -w -N CC_WA_IMPORT_V1 2>/dev/null || true
 "$tool" -w -F CC_WA_IMPORT_V1
 "$tool" -w -A CC_WA_IMPORT_V1 -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
 if [ "$tool" = /usr/sbin/iptables ]; then
  "$tool" -w -A CC_WA_IMPORT_V1 -p tcp -d 127.0.0.1 --dport 3306 -j RETURN
  "$tool" -w -A CC_WA_IMPORT_V1 -p tcp -d 13.39.100.55 --dport 8445 -j RETURN
 fi
 "$tool" -w -A CC_WA_IMPORT_V1 -j REJECT
 "$tool" -w -C OUTPUT -m owner --uid-owner 997 -j CC_WA_IMPORT_V1 2>/dev/null || "$tool" -w -I OUTPUT 1 -m owner --uid-owner 997 -j CC_WA_IMPORT_V1
 "$tool" -w -D OUTPUT -m owner --uid-owner 997 -j REJECT
done
