[Unit]
Description=Rotate the dedicated local platform-cost IAM Roles Anywhere certificate
ConditionPathExists=/etc/clinicaclick-costs/authority/ca.pem
ConditionPathExists=/etc/clinicaclick-costs/authority/ca-key.pem

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/libexec/clinicaclick-cost-rotate-certificate --rotate-if-needed
TimeoutStartSec=90
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/clinicaclick-costs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_CHOWN
StandardOutput=journal
StandardError=journal
