# Meta / Graph API
META_API_BASE_URL=https://graph.facebook.com/v23.0

# Plantillas WhatsApp: un solo reenvío lógico cuando Meta mantiene una copia
# de catálogo en PENDING/IN_REVIEW durante más del umbral configurado.
WHATSAPP_TEMPLATE_AUTO_RESUBMIT_ENABLED=true
WHATSAPP_TEMPLATE_AUTO_RESUBMIT_PENDING_MINUTES=60

# Jobs: horarios y control
JOBS_TIMEZONE=Europe/Madrid
JOBS_AUTO_START=false
JOBS_ADS_SCHEDULE=30 3 * * *
JOBS_METRICS_SCHEDULE=0 2 * * *
JOBS_TOKEN_VALIDATION_SCHEDULE=0 */6 * * *
JOBS_CLEANUP_SCHEDULE=0 3 * * 0
JOBS_HEALTH_CHECK_SCHEDULE=0 * * * *
JOBS_COMPETITION_SCHEDULE=0 6 * * 1
# Retención técnica del host: el job rota los logs activos de PM2 y elimina
# únicamente ficheros inactivos con más antigüedad que la indicada.
JOBS_PM2_LOG_RETENTION_SCHEDULE=17 3 * * *
PM2_LOG_RETENTION_DAYS=60
PM2_LOG_RETENTION_DIRECTORY=

# Bridges OPS migrados desde crontab. El catálogo conserva UTC para que el
# cutover no cambie su hora efectiva; estas expresiones se interpretan en UTC.
JOBS_OPS_GLOBAL_DISCOVERY_SCHEDULE=17 */4 * * *
JOBS_OPS_SUMMARY_SCHEDULE=31 */6 * * *
JOBS_OPS_GBP_DAILY_SCHEDULE=43 6 * * *
JOBS_OPS_SEARCH_CONSOLE_SCHEDULE=12 7 * * *
JOBS_OPS_GBP_REQUESTED_SCHEDULE=18,48 * * * *
OPS_API_URL=https://ops.conmigas.com
OPS_INTERNAL_API_TOKEN=

# Ads sync: ventanas y límites (mitigar 500 de Meta)
# Días por chunk de insights/actions (1..7 recomendado)
ADS_CHUNK_DAYS=3
# Límite por página en insights/actions (50..200 recomendado)
ADS_PAGE_LIMIT=100
# Límite por página en listado de ads (entities). El código baja a 25 si hay 500.
ADS_ENTITIES_LIMIT=50
# Ventanas usadas por el job de ads: primera sync vs recents
ADS_SYNC_INITIAL_DAYS=30
ADS_SYNC_RECENT_DAYS=7
ADS_SYNC_BACKFILL_DAYS=28
ADS_SYNC_BETWEEN_ACCOUNTS_SLEEP_MS=60000

# Cliente Meta (throttling)
METASYNC_REQUEST_DELAY_MS=300
METASYNC_RATE_LIMIT_THRESHOLD=90
METASYNC_MAX_RETRIES=3
METASYNC_WAIT_NEXT_HOUR_ON_LIMIT=true

# Competencia local (Marketing > Informes > Competencia)
GOOGLE_PLACES_API_KEY=
META_AD_LIBRARY_ACCESS_TOKEN=
COMPETITION_SUGGESTION_LIMIT=10
COMPETITION_META_AD_LIMIT=25
COMPETITION_META_AD_COUNTRY=ES
COMPETITION_META_BROWSER_MEDIA_MODE=auto
COMPETITION_META_BROWSER_MEDIA_LIMIT=25
COMPETITION_META_BROWSER_MEDIA_TIMEOUT_MS=15000
COMPETITION_META_BROWSER_MEDIA_IDLE_MS=60000
COMPETITION_META_BROWSER_MEDIA_MIN_MISSING=1
# Opcional: ruta a Chromium/Chrome si el servidor lo tiene instalado.
COMPETITION_BROWSER_EXECUTABLE_PATH=
COMPETITION_LOCAL_HEATMAP_GRID_SIZE=3
COMPETITION_LOCAL_HEATMAP_MAX_POINTS=9
COMPETITION_LOCAL_HEATMAP_RESULT_LIMIT=10

# Visibilidad local en asistentes de IA (solo backend; nunca exponer claves al frontend)
# OpenAI usa Responses API + web_search con store=false.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=
OPENAI_AI_VISIBILITY_MODEL=gpt-5.6
# Gemini usa Interactions API + google_search con store=false.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=clinicaclick
GOOGLE_CLOUD_PROJECT_NUMBER=4955619485
GEMINI_AI_VISIBILITY_MODEL=gemini-3.5-flash
# Control de coste y retención de los resultados visibles para el usuario.
AI_VISIBILITY_CACHE_HOURS=24
AI_VISIBILITY_MAX_RUNS_PER_CLINIC_24H=3
AI_VISIBILITY_RETENTION_DAYS=30
AI_VISIBILITY_PROVIDER_TIMEOUT_MS=90000

# App
PORT=3000
JWT_SECRET=please-change-me
# Optional dedicated secret for short-lived, server-observed website verification proofs.
# Falls back to JWT_SECRET when omitted.
INTAKE_VERIFICATION_ATTESTATION_SECRET=
# Accepted proofs use a separate operational lease (24h by default, capped at 7 days).
# The signed submission token itself always expires after 15-20 minutes.
INTAKE_PERSISTED_VERIFICATION_TTL_SECONDS=86400

# Public media storage (solo assets publicos/no clinicos)
# Las credenciales AWS reales se configuran como variables seguras del servidor o rol IAM.
AWS_DEFAULT_REGION=eu-west-3
PUBLIC_MEDIA_BUCKET=clinicaclick-public-media-eu-west-3
PUBLIC_MEDIA_BASE_URL=https://media.clinicaclick.com
CLOUDFRONT_DISTRIBUTION_ID=E3TRXQ4DMSYUVL
# Opcional si los recursos PUBLIC_MEDIA viven en otra cuenta AWS:
# PUBLIC_MEDIA_ASSUME_ROLE_ARN=arn:aws:iam::137819318729:role/ClinicaclickPublicMediaUploader

# DB (usadas por Sequelize)
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_SQL_LOGGING=false

# Google Ads API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://autenticacion.clinicaclick.com/oauth/google/callback
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/webmasters.readonly https://www.googleapis.com/auth/analytics.readonly https://www.googleapis.com/auth/business.manage https://www.googleapis.com/auth/adwords https://www.googleapis.com/auth/datamanager"
GOOGLE_ADS_API_ENDPOINT=https://googleads.googleapis.com
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_ID=
GOOGLE_ADS_API_VERSION=v21
GOOGLE_ADS_API_VERSION_FALLBACKS=v20,v19,v18,v17,v16,v15
GOOGLE_ADS_DAILY_QUOTA=1500
GOOGLE_ADS_SYNC_INITIAL_DAYS=30
GOOGLE_ADS_SYNC_RECENT_DAYS=7
GOOGLE_ADS_SYNC_CHUNK_DAYS=7
GOOGLE_ADS_BACKFILL_DAYS=180
GOOGLE_ADS_SYNC_BETWEEN_ACCOUNTS_SLEEP_MS=2000
SYNC_PROVIDER_HTTP_TIMEOUT_MS=30000
META_PROVIDER_HTTP_TIMEOUT_MS=30000
GOOGLE_ADS_HTTP_TIMEOUT_MS=30000
GOOGLE_ADS_USAGE_THRESHOLD=90
GOOGLE_ADS_HEALTH_MIN_SPEND=1
GOOGLE_ADS_HEALTH_CTR_MIN=0.02
GOOGLE_ADS_HEALTH_CPA_MAX=25
GOOGLE_ADS_HEALTH_CPA_GROWTH=0.3
GOOGLE_ADS_HEALTH_MIN_IMPRESSIONS=200
JOBS_GOOGLE_ADS_SCHEDULE="20 5 * * *"
JOBS_GOOGLE_ADS_BACKFILL_SCHEDULE="30 5 * * 0"

# Worker durable de JobRequests (exactamente un proceso por namespace)
JOB_SCHEDULER_STARTUP_RETRY_BASE_DELAY_MS=1000
JOB_SCHEDULER_STARTUP_RETRY_MAX_DELAY_MS=30000
JOB_SCHEDULER_BACKGROUND_INTERVAL_MS=5000
JOB_SCHEDULER_RETRY_BASE_DELAY_MS=60000
JOB_SCHEDULER_RETRY_MAX_DELAY_MS=1800000

# Google Data Manager API (conversiones server-side)
GOOGLE_DATA_MANAGER_API_BASE_URL=https://datamanager.googleapis.com/v1
GOOGLE_DATA_MANAGER_QUOTA_PROJECT=
GOOGLE_DATA_MANAGER_DEFAULT_PHONE_COUNTRY_CODE=34
JOBS_GOOGLE_DATA_MANAGER_DIAGNOSTICS_SCHEDULE="*/30 * * * *"
JOBS_GOOGLE_CONVERSION_GOAL_POLICY_AUDIT_SCHEDULE="17 2 * * *"
