# Meta / Graph API
META_API_BASE_URL=https://graph.facebook.com/v23.0
META_API_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
# La auditoría horaria confirma la suscripción WABA y los campos messages,
# account_update y account_review_update sin modificar la configuración Meta.
WHATSAPP_PHONE_FULL_SYNC_INTERVAL_MINUTES=60
WHATSAPP_HEALTH_STALE_MINUTES=90

# Plantillas WhatsApp: un solo reenvío lógico cuando Meta mantiene una copia
# de catálogo en PENDING/IN_REVIEW durante más del umbral configurado.
WHATSAPP_TEMPLATE_AUTO_RESUBMIT_ENABLED=true
WHATSAPP_TEMPLATE_AUTO_RESUBMIT_PENDING_MINUTES=60

# Jobs: horarios y control
JOBS_TIMEZONE=Europe/Madrid
JOBS_AUTO_START=false
JOBS_ADS_SCHEDULE=30 3 * * *
JOBS_METRICS_SCHEDULE=0 2 * * *
JOBS_TOKEN_VALIDATION_SCHEDULE=0 */6 * * *
JOBS_CLEANUP_SCHEDULE=0 3 * * 0
JOBS_HEALTH_CHECK_SCHEDULE=0 * * * *
JOBS_SYSTEM_NOTIFICATION_CHECK_SCHEDULE=*/5 * * * *
JOBS_COMPETITION_SCHEDULE=0 6 * * 1
# Retención técnica del host: el job rota los logs activos de PM2 y elimina
# únicamente ficheros inactivos con más antigüedad que la indicada.
JOBS_PM2_LOG_RETENTION_SCHEDULE=17 3 * * *
PM2_LOG_RETENTION_DAYS=60
PM2_LOG_RETENTION_DIRECTORY=

# Bridges OPS migrados desde crontab. El catálogo conserva UTC para que el
# cutover no cambie su hora efectiva; estas expresiones se interpretan en UTC.
JOBS_OPS_GLOBAL_DISCOVERY_SCHEDULE=17 */4 * * *
JOBS_OPS_SUMMARY_SCHEDULE=31 */6 * * *
JOBS_OPS_GBP_DAILY_SCHEDULE=43 6 * * *
JOBS_OPS_SEARCH_CONSOLE_SCHEDULE=12 7 * * *
JOBS_OPS_GBP_REQUESTED_SCHEDULE=18,48 * * * *
OPS_API_URL=https://ops.conmigas.com
OPS_INTERNAL_API_TOKEN=
OPS_GLOBAL_DISCOVERY_PLATFORMS=meta,google_ads
OPS_META_RATE_LIMIT_COOLDOWN_MS=7200000

# Ads sync: ventanas y límites (mitigar 500 de Meta)
# Días por chunk de insights/actions (1..7 recomendado)
ADS_CHUNK_DAYS=3
# Límite por página en insights/actions (50..200 recomendado)
ADS_PAGE_LIMIT=100
# Límite por página en listado de ads (entities). El código baja a 25 si hay 500.
ADS_ENTITIES_LIMIT=50
# Ventanas usadas por el job de ads: primera sync vs recents
ADS_SYNC_INITIAL_DAYS=30
ADS_SYNC_RECENT_DAYS=7
ADS_SYNC_BACKFILL_DAYS=28
ADS_SYNC_BETWEEN_ACCOUNTS_SLEEP_MS=60000

# Cliente Meta (throttling)
METASYNC_REQUEST_DELAY_MS=300
METASYNC_RATE_LIMIT_THRESHOLD=90
METASYNC_RATE_LIMIT_COOLDOWN_MS=7200000
METASYNC_MAX_RETRIES=3
METASYNC_WAIT_NEXT_HOUR_ON_LIMIT=true
META_OAUTH_RATE_LIMIT_COOLDOWN_MS=7200000
META_DEBUG_TOKEN_STATUS_CACHE_TTL_MS=1800000

# Competencia local (Marketing > Informes > Competencia)
GOOGLE_PLACES_API_KEY=
META_AD_LIBRARY_ACCESS_TOKEN=
COMPETITION_SUGGESTION_LIMIT=10
COMPETITION_META_AD_LIMIT=25
COMPETITION_META_AD_COUNTRY=ES
COMPETITION_META_BROWSER_MEDIA_MODE=auto
COMPETITION_META_BROWSER_MEDIA_LIMIT=25
COMPETITION_META_BROWSER_MEDIA_TIMEOUT_MS=15000
COMPETITION_META_BROWSER_MEDIA_IDLE_MS=60000
COMPETITION_META_BROWSER_MEDIA_MIN_MISSING=1
# Opcional: ruta a Chromium/Chrome si el servidor lo tiene instalado.
COMPETITION_BROWSER_EXECUTABLE_PATH=
COMPETITION_LOCAL_HEATMAP_GRID_SIZE=3
COMPETITION_LOCAL_HEATMAP_MAX_POINTS=9
COMPETITION_LOCAL_HEATMAP_RESULT_LIMIT=10

# Visibilidad local en asistentes de IA (solo backend; nunca exponer claves al frontend)
# Texto clínico y Automatizaciones V2. Usa credenciales IAM exclusivas; no
# reutilizar las de PUBLIC_MEDIA. Los perfiles eu.amazon.* mantienen el
# procesamiento dentro de regiones de la UE, pero no exclusivamente en España.
BEDROCK_ENABLED=false
BEDROCK_REGION=eu-south-2
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_SESSION_TOKEN=
BEDROCK_MODEL_FAST=eu.amazon.nova-micro-v1:0
BEDROCK_MODEL_COMPLEX=eu.amazon.nova-lite-v1:0
BEDROCK_MODEL_ASSISTANT=eu.amazon.nova-pro-v1:0
BEDROCK_MODEL_FALLBACK=eu.amazon.nova-lite-v1:0
BEDROCK_TIMEOUT_MS=20000
AI_HEALTH_CACHE_TTL_MS=14400000
# Groq queda limitado a transcripción de audio mientras se migra a proveedor UE.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo

# OpenAI usa Responses API + web_search con store=false.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=
OPENAI_AI_VISIBILITY_MODEL=gpt-5.6
# Asistente editorial de Marketing > Web > Contenidos. Usa Responses API
# server-side con Structured Outputs y `store=false`; solo crea borradores.
OPENAI_WEB_CONTENT_MODEL=gpt-5.6
OPENAI_WEB_CONTENT_TIMEOUT_MS=90000
WEB_CONTENT_GENERATION_RETENTION_DAYS=180
WEB_CONTENT_GENERATION_HOURLY_USER_SCOPE_LIMIT=12
WEB_CONTENT_GENERATION_HOURLY_GLOBAL_LIMIT=300
# Gemini usa Interactions API + google_search con store=false.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=clinicaclick
GOOGLE_CLOUD_PROJECT_NUMBER=4955619485
# Dataset público oficial de Google Ads Transparency (consulta server-side).
# Usa GOOGLE_APPLICATION_CREDENTIALS o uno de los JSON gestionados fuera de Git.
COMPETITION_GOOGLE_ADS_TRANSPARENCY_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_BIGQUERY_SERVICE_ACCOUNT_JSON=
GOOGLE_BIGQUERY_SERVICE_ACCOUNT_JSON_BASE64=
COMPETITION_GOOGLE_ADS_TRANSPARENCY_BIGQUERY_LOCATION=US
COMPETITION_GOOGLE_ADS_TRANSPARENCY_MAX_BYTES_BILLED=10000000000
GEMINI_AI_VISIBILITY_MODEL=gemini-3.5-flash
# Control de coste: el GET de Informes es el único disparador automático y
# cada consulta se ejecuta como máximo una vez cada siete días por clínica.
AI_VISIBILITY_REFRESH_INTERVAL_DAYS=7
AI_VISIBILITY_MAX_RUNS_PER_CLINIC_7D=4
# Retención local (siempre >= al intervalo de refresco) para conservar
# resultados, fuentes y citas; no aumenta la frecuencia de proveedores.
AI_VISIBILITY_RETENTION_DAYS=30
AI_VISIBILITY_PROVIDER_TIMEOUT_MS=90000

# App
PORT=3000
JWT_SECRET=please-change-me
# Email transaccional server-side. No exponer claves en frontend, DB ni Git.
# Dev arranca en mock. Para SES real: EMAIL_PROVIDER=ses y EMAIL_ENABLED=true.
EMAIL_PROVIDER=mock
EMAIL_ENABLED=false
EMAIL_MARKETING_ENABLED=false
EMAIL_AWS_REGION=eu-west-3
EMAIL_AWS_ACCESS_KEY_ID=
EMAIL_AWS_SECRET_ACCESS_KEY=
EMAIL_AWS_SESSION_TOKEN=
EMAIL_DEFAULT_FROM="Clinicaclick <no-contestar@clinicaclick.com>"
EMAIL_DEFAULT_REPLY_TO=
EMAIL_TRANSACTIONAL_CONFIGURATION_SET=clinicaclick-transactional
EMAIL_MARKETING_CONFIGURATION_SET=clinicaclick-marketing-disabled
EMAIL_CUSTOM_MAIL_FROM_DOMAIN=bounce.clinicaclick.com
EMAIL_SES_SANDBOX_MODE=true
EMAIL_RECIPIENT_ALLOWLIST=
EMAIL_REQUIRE_RECIPIENT_ALLOWLIST=true
EMAIL_PROVIDER_TIMEOUT_MS=15000
EMAIL_MAX_ATTEMPTS=3
EMAIL_PUBLIC_APP_URL=http://localhost:4203
EMAIL_PASSWORD_RESET_TTL_MINUTES=30
EMAIL_PASSWORD_RESET_MIN_INTERVAL_SECONDS=60
EMAIL_PASSWORD_RESET_MAX_PER_HOUR=5
EMAIL_PASSWORD_RESET_IP_MAX_PER_HOUR=20
EMAIL_DATA_ENCRYPTION_KEY=
EMAIL_AUDIT_HASH_SALT=
EMAIL_EVENT_WEBHOOK_TOKEN=
EMAIL_AUTOMATION_GENERIC_ENABLED=false
# Estado operativo declarado del stack de alarmas; no concede acceso AWS.
EMAIL_AWS_MONITORING_STATUS=not_configured
EMAIL_AWS_MONITORING_STACK_NAME=
EMAIL_AWS_MONITORING_ALARM_COUNT=0
EMAIL_AWS_MONITORING_LAST_VERIFIED_AT=
# Notificaciones operativas de administración. Destinatarios y sender se
# configuran por entorno desde BD/admin UI o secretos; no guardar teléfonos,
# emails reales ni tokens en Git.
SYSTEM_NOTIFICATIONS_ENABLED=true
SYSTEM_NOTIFICATIONS_PANEL_ENABLED=true
SYSTEM_NOTIFICATIONS_EMAIL_ENABLED=false
SYSTEM_NOTIFICATIONS_WHATSAPP_ENABLED=false
SYSTEM_NOTIFICATIONS_ADMIN_EMAIL=
SYSTEM_NOTIFICATIONS_ADMIN_WHATSAPP=
SYSTEM_NOTIFICATIONS_WHATSAPP_SENDER_ASSET_ID=
SYSTEM_NOTIFICATIONS_WHATSAPP_TEMPLATE_NAME=clinicaclick_admin_alerta_sistema
SYSTEM_NOTIFICATIONS_WHATSAPP_TEMPLATE_LANGUAGE=es
SYSTEM_NOTIFICATIONS_THROTTLE_MINUTES=60
# Un único runtime por namespace debe crear el check durable. En DEV, el
# namespace `dev` asume ownership si esta variable no está definida.
SYSTEM_NOTIFICATIONS_CRON_LEADER=false
# Clave AES-256-GCM dedicada para IBAN y otros datos contables sensibles.
# Generar fuera de Git (`openssl rand -hex 32`) y conservarla estable por entorno.
ACCOUNTING_DATA_ENCRYPTION_KEY=
# Optional dedicated secret for short-lived, server-observed website verification proofs.
# Falls back to JWT_SECRET when omitted.
INTAKE_VERIFICATION_ATTESTATION_SECRET=
# HMAC de respaldo para integraciones server-to-server que no tengan un
# IntakeConfig con secreto propio. No exponer en frontend, snippets ni plugins.
INTAKE_WEB_SECRET=
# Accepted proofs use a separate operational lease (24h by default, capped at 7 days).
# The signed submission token itself always expires after 15-20 minutes.
INTAKE_PERSISTED_VERIFICATION_TTL_SECONDS=86400

# Public media storage (solo assets publicos/no clinicos)
# Las credenciales AWS reales se configuran como variables seguras del servidor o rol IAM.
AWS_DEFAULT_REGION=eu-west-3
PUBLIC_MEDIA_BUCKET=clinicaclick-public-media-eu-west-3
PUBLIC_MEDIA_BASE_URL=https://media.clinicaclick.com
CLOUDFRONT_DISTRIBUTION_ID=E3TRXQ4DMSYUVL
# Comma-separated extra origins allowed when Chromium renders economic PDFs.
ECONOMIC_PDF_ASSET_ORIGINS=
# Opcional si los recursos PUBLIC_MEDIA viven en otra cuenta AWS:
# PUBLIC_MEDIA_ASSUME_ROLE_ARN=arn:aws:iam::137819318729:role/ClinicaclickPublicMediaUploader

# DB (usadas por Sequelize)
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_SQL_LOGGING=false

# Google Ads API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://autenticacion.clinicaclick.com/oauth/google/callback
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/webmasters.readonly https://www.googleapis.com/auth/analytics.readonly https://www.googleapis.com/auth/business.manage https://www.googleapis.com/auth/adwords https://www.googleapis.com/auth/datamanager"
GOOGLE_ADS_API_ENDPOINT=https://googleads.googleapis.com
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_ID=
GOOGLE_ADS_API_VERSION=v21
GOOGLE_ADS_API_VERSION_FALLBACKS=v20,v19,v18,v17,v16,v15
GOOGLE_ADS_DAILY_QUOTA=1500
GOOGLE_ADS_SYNC_INITIAL_DAYS=30
GOOGLE_ADS_SYNC_RECENT_DAYS=7
GOOGLE_ADS_SYNC_CHUNK_DAYS=7
GOOGLE_ADS_BACKFILL_DAYS=180
GOOGLE_ADS_SYNC_BETWEEN_ACCOUNTS_SLEEP_MS=2000
SYNC_PROVIDER_HTTP_TIMEOUT_MS=30000
META_PROVIDER_HTTP_TIMEOUT_MS=30000
GOOGLE_ADS_HTTP_TIMEOUT_MS=30000
GOOGLE_ADS_USAGE_THRESHOLD=90
GOOGLE_ADS_HEALTH_MIN_SPEND=1
GOOGLE_ADS_HEALTH_CTR_MIN=0.02
GOOGLE_ADS_HEALTH_CPA_MAX=25
GOOGLE_ADS_HEALTH_CPA_GROWTH=0.3
GOOGLE_ADS_HEALTH_MIN_IMPRESSIONS=200
# Ejecución real de Piloto automático. Fail-closed y apagada por defecto:
# habilitar solo tras migración, dry-run, readback, prepago y aprobación admin.
MANAGED_CAMPAIGN_PROVIDER_EXECUTION_ENABLED=false
MANAGED_CAMPAIGN_PROVIDER_ACTIVATION_ENABLED=false
JOBS_GOOGLE_ADS_SCHEDULE="20 5 * * *"
JOBS_GOOGLE_ADS_BACKFILL_SCHEDULE="30 5 * * 0"

# Worker durable de JobRequests (exactamente un proceso por namespace)
JOB_SCHEDULER_STARTUP_RETRY_BASE_DELAY_MS=1000
JOB_SCHEDULER_STARTUP_RETRY_MAX_DELAY_MS=30000
JOB_SCHEDULER_BACKGROUND_INTERVAL_MS=5000
JOB_SCHEDULER_RETRY_BASE_DELAY_MS=60000
JOB_SCHEDULER_RETRY_MAX_DELAY_MS=1800000

# Google Data Manager API (conversiones server-side)
GOOGLE_DATA_MANAGER_API_BASE_URL=https://datamanager.googleapis.com/v1
GOOGLE_DATA_MANAGER_QUOTA_PROJECT=
GOOGLE_DATA_MANAGER_DEFAULT_PHONE_COUNTRY_CODE=34
JOBS_GOOGLE_DATA_MANAGER_DIAGNOSTICS_SCHEDULE="*/30 * * * *"
JOBS_GOOGLE_CONVERSION_GOAL_POLICY_AUDIT_SCHEDULE="17 2 * * *"
JOBS_MARKETING_WEB_DOMAIN_RECONCILIATION_SCHEDULE="7,22,37,52 * * * *"
# Lectura pública ligera (una petición por publicación seleccionada), sin
# autoreparaciones ni llamadas a APIs publicitarias.
JOBS_MARKETING_WEB_PUBLICATION_HEALTH_SCHEDULE="11 * * * *"
JOBS_CAMPAIGN_DESTINATION_DRIFT_AUDIT_SCHEDULE="5 3 * * *"
# Marketing Web editor rollout. Editor y publicación son fail-closed: cada
# entorno debe habilitarlos expresamente cuando alcance su fase de rollout.
MARKETING_WEB_EDITOR_ENABLED=false
MARKETING_WEB_PUBLISHING_ENABLED=false
# Allowlist opcional por alcance, CSV: clinic:66,group:4. Vacío conserva el
# rollout global cuando el gate está activo; no se infiere herencia de grupo.
MARKETING_WEB_ENABLED_SCOPES=
# Allowlist adicional para publicar. Si se define, el editor puede seguir
# disponible en más scopes sin abrir destinos ni artefactos fuera del piloto.
MARKETING_WEB_PUBLISHING_SCOPES=
# Kill switch por alcance. Siempre prevalece sobre la allowlist.
MARKETING_WEB_DISABLED_SCOPES=
# Canales de publicación. WordPress conserva autodetección operativa cuando el
# override queda vacío; false lo apaga expresamente. Hosting y dominio propio
# son opt-in y permanecen cerrados hasta que su infraestructura esté operativa.
MARKETING_WEB_WORDPRESS_CHANNEL_ENABLED=
MARKETING_WEB_HOSTED_CHANNEL_ENABLED=false
MARKETING_WEB_CUSTOM_DOMAIN_CHANNEL_ENABLED=false
# Biblioteca web. Las subidas quedan en cuarentena hasta registrarlas en el CMS.
MARKETING_WEB_MEDIA_MAX_ASSETS_PER_SCOPE=500
MARKETING_WEB_MEDIA_MAX_BYTES_PER_SCOPE=2147483648
MARKETING_WEB_MEDIA_QUARANTINE_HOURS=24
# Public control plane used by the maintained Clinicaclick WordPress plugin.
# It must be an HTTPS origin without path; credentials are never embedded here.
MARKETING_WEB_API_BASE_URL=https://crm.clinicaclick.com
# Ticket AES-256-GCM de 15 minutos usado para entregar el ZIP provisionado sin
# exponer el token de instalación en la UI. Generar fuera de Git con
# `openssl rand -base64 32` y guardar como secreto distinto por entorno.
MARKETING_WEB_PLUGIN_BOOTSTRAP_KEY=
# Challenge independiente de 256 bits para demostrar control same-origin del
# WordPress antes de promover pending. El backend conserva solo SHA-256 y
# caducidad; el valor raw viaja exclusivamente dentro del ZIP provisionado.
MARKETING_WEB_WORDPRESS_SITE_CLAIM_TTL_SECONDS=86400
# Clave dedicada AES-256-GCM para los snapshots HMAC source/target del
# reconciliador. Generar fuera de Git (`openssl rand -base64 32`) y mantener el
# mismo KEY_ID mientras existan envelopes cifrados con ella.
MARKETING_WEB_RUNTIME_ENVELOPE_KEY=
MARKETING_WEB_RUNTIME_ENVELOPE_KEY_ID=runtime-envelope-v1
# Gracia source/target tras todos los ACK (24 h por defecto; 1 min..7 días).
MARKETING_WEB_RUNTIME_HMAC_GRACE_MS=86400000
# Flag de migración de un solo uso. NO dejarlo en el entorno permanente: solo
# exportar `true` en el proceso migrador tras detener API/workers y completar
# el preflight DB documentado.
MARKETING_WEB_RUNTIME_SECRET_MIGRATION_QUIESCED=false
# Clave Ed25519 de firma. La privada nunca sale del backend; la pública se
# provisiona en el plugin para verificar runtime y artefactos.
MARKETING_WEB_SIGNING_PRIVATE_KEY_PEM=
MARKETING_WEB_SIGNING_PUBLIC_KEY_PEM=
# Solo durante una rotación online: dirección old -> current explícita y privada
# anterior temporal para firmar exclusivamente el descriptor público current.
# Eliminar ambas cuando todas las instalaciones tengan public_key_id=current.
MARKETING_WEB_SIGNING_ROTATION_FROM_KEY_ID=
MARKETING_WEB_SIGNING_PREVIOUS_PRIVATE_KEY_PEM=
# Artefactos inmutables consumidos por WordPress. `authenticated_db` sirve el
# WebArtifact ya persistido mediante URLs same-origin autenticadas y es el modo
# por defecto cuando no hay S3. `s3` requiere bucket y base URL pública.
MARKETING_WEB_ARTIFACT_STORE_MODE=authenticated_db
MARKETING_WEB_ARTIFACT_BUCKET=
MARKETING_WEB_ARTIFACT_BASE_URL=
MARKETING_WEB_ARTIFACT_REGION=eu-west-3
MARKETING_WEB_ARTIFACT_PREFIX=marketing-web
# El monitor rota por las publicaciones menos recientemente comprobadas.
MARKETING_WEB_PUBLICATION_HEALTH_BATCH_SIZE=25
# Publicación alojada por ClinicaClick.
MARKETING_WEB_HOSTED_DOMAIN=sites.clinicaclick.com
MARKETING_WEB_HOSTED_MODE=path
MARKETING_WEB_HOSTING_ROOT=/var/lib/clinicaclick-web-hosting
# Dominios propios. `manual` mantiene la comprobación DNS/TLS tradicional;
# `cloudflare` registra Custom Hostnames server-side y nunca expone el token.
MARKETING_WEB_CUSTOM_HOSTNAME_PROVIDER=manual
MARKETING_WEB_CUSTOM_DOMAIN_TARGET=sites.clinicaclick.com
CLOUDFLARE_API_TOKEN=
MARKETING_WEB_CLOUDFLARE_ZONE_ID=
MARKETING_WEB_CLOUDFLARE_CUSTOM_ORIGIN=sites.clinicaclick.com
# Proxies que Express puede confiar al resolver req.ip. El valor por defecto
# cubre el Nginx local; amplíalo solo con redes controladas.
HTTP_TRUST_PROXY=loopback
MARKETING_WEB_RATE_LIMIT_PREFIX=clinicaclick:marketing-web-rate-limit:v1
