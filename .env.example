# Meta / Graph API
META_API_BASE_URL=https://graph.facebook.com/v23.0

# Jobs: horarios y control
JOBS_TIMEZONE=Europe/Madrid
JOBS_AUTO_START=false
JOBS_ADS_SCHEDULE=30 3 * * *
JOBS_METRICS_SCHEDULE=0 2 * * *
JOBS_TOKEN_VALIDATION_SCHEDULE=0 */6 * * *
JOBS_CLEANUP_SCHEDULE=0 3 * * 0
JOBS_HEALTH_CHECK_SCHEDULE=0 * * * *
JOBS_COMPETITION_SCHEDULE=0 6 * * 1

# Ads sync: ventanas y límites (mitigar 500 de Meta)
# Días por chunk de insights/actions (1..7 recomendado)
ADS_CHUNK_DAYS=3
# Límite por página en insights/actions (50..200 recomendado)
ADS_PAGE_LIMIT=100
# Límite por página en listado de ads (entities). El código baja a 25 si hay 500.
ADS_ENTITIES_LIMIT=50
# Ventanas usadas por el job de ads: primera sync vs recents
ADS_SYNC_INITIAL_DAYS=30
ADS_SYNC_RECENT_DAYS=7
ADS_SYNC_BACKFILL_DAYS=28
ADS_SYNC_BETWEEN_ACCOUNTS_SLEEP_MS=60000

# Cliente Meta (throttling)
METASYNC_REQUEST_DELAY_MS=300
METASYNC_RATE_LIMIT_THRESHOLD=90
METASYNC_MAX_RETRIES=3
METASYNC_WAIT_NEXT_HOUR_ON_LIMIT=true

# Competencia local (Marketing > Informes > Competencia)
GOOGLE_PLACES_API_KEY=
META_AD_LIBRARY_ACCESS_TOKEN=
COMPETITION_SUGGESTION_LIMIT=10
COMPETITION_META_AD_LIMIT=25
COMPETITION_META_AD_COUNTRY=ES
COMPETITION_META_BROWSER_MEDIA_MODE=auto
COMPETITION_META_BROWSER_MEDIA_LIMIT=5
COMPETITION_META_BROWSER_MEDIA_TIMEOUT_MS=15000
COMPETITION_META_BROWSER_MEDIA_IDLE_MS=60000
COMPETITION_META_BROWSER_MEDIA_MIN_MISSING=1
# Opcional: ruta a Chromium/Chrome si el servidor lo tiene instalado.
COMPETITION_BROWSER_EXECUTABLE_PATH=
COMPETITION_LOCAL_HEATMAP_GRID_SIZE=3
COMPETITION_LOCAL_HEATMAP_MAX_POINTS=9
COMPETITION_LOCAL_HEATMAP_RESULT_LIMIT=10

# App
PORT=3000
JWT_SECRET=please-change-me

# DB (usadas por Sequelize)
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost

# Google Ads API
GOOGLE_ADS_API_ENDPOINT=https://googleads.googleapis.com
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_ID=
GOOGLE_ADS_API_VERSION=v21
GOOGLE_ADS_API_VERSION_FALLBACKS=v20,v19,v18,v17,v16,v15
GOOGLE_ADS_DAILY_QUOTA=1500
GOOGLE_ADS_SYNC_INITIAL_DAYS=30
GOOGLE_ADS_SYNC_RECENT_DAYS=7
GOOGLE_ADS_SYNC_CHUNK_DAYS=7
GOOGLE_ADS_BACKFILL_DAYS=180
GOOGLE_ADS_SYNC_BETWEEN_ACCOUNTS_SLEEP_MS=2000
GOOGLE_ADS_USAGE_THRESHOLD=90
GOOGLE_ADS_HEALTH_MIN_SPEND=1
GOOGLE_ADS_HEALTH_CTR_MIN=0.02
GOOGLE_ADS_HEALTH_CPA_MAX=25
GOOGLE_ADS_HEALTH_CPA_GROWTH=0.3
GOOGLE_ADS_HEALTH_MIN_IMPRESSIONS=200
JOBS_GOOGLE_ADS_SCHEDULE="20 5 * * *"
JOBS_GOOGLE_ADS_BACKFILL_SCHEDULE="30 5 * * 0"
