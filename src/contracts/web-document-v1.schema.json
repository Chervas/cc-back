    "buttonNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "props", "children"],
      "properties": {
        "id": { "$ref": "#/definitions/safeId" },
        "type": { "const": "button" },
        "version": { "const": 1 },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "action", "target", "variant"],
          "properties": {
            "label": {
              "allOf": [
                { "$ref": "#/definitions/plainText" },
                { "minLength": 1, "maxLength": 120 }
              ]
            },
            "action": {
              "enum": ["internal_page", "external_url", "phone", "whatsapp", "intake_form_anchor"]
            },
            "target": {
              "type": "string",
              "minLength": 3,
              "maxLength": 2048
            },
            "variant": {
              "enum": ["primary", "secondary", "outline", "link"]
            },
            "open_in_new_tab": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": { "properties": { "action": { "const": "external_url" } } },
              "then": { "properties": { "target": { "pattern": "^https://[^\\s]+$" } } }
            },
            {
              "if": { "properties": { "action": { "enum": ["phone", "whatsapp"] } } },
              "then": { "properties": { "target": { "pattern": "^\\+[1-9][0-9]{7,14}$" } } }
            },
            {
              "if": { "properties": { "action": { "enum": ["internal_page", "intake_form_anchor"] } } },
              "then": { "properties": { "target": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$", "maxLength": 64 } } }
            }
          ]
        },
        "children": {
          "type": "array",
          "maxItems": 0
        },
        "style_tokens": { "$ref": "#/definitions/styleTokens" },
        "responsive": { "$ref": "#/definitions/responsive" },
        "animation": { "$ref": "#/definitions/animationPreset" },
        "binding_ids": { "$ref": "#/definitions/bindingIds" }
      }
    },
