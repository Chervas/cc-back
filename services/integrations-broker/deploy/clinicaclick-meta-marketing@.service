[Unit]
Description=ClinicaClick %i Meta authorization and selected-asset broker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=cc-meta-%i
Group=cc-meta-%i
WorkingDirectory=/opt/clinicaclick-meta-marketing/current
Environment=AWS_CONFIG_FILE=/dev/null AWS_SHARED_CREDENTIALS_FILE=/dev/null AWS_EC2_METADATA_V1_DISABLED=true AWS_EC2_METADATA_SERVICE_ENDPOINT=http://169.254.169.254
ExecStart=/opt/clinicaclick-audit/node-v24.21.0-recovery1/bin/node --max-old-space-size=96 src/meta-marketing-oauth-main.js /etc/clinicaclick-meta-marketing-%i/config.json
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/clinicaclick-meta-marketing-%i
UMask=0077
LimitCORE=0
LimitNOFILE=256
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
MemoryMax=192M
MemoryHigh=160M
CPUQuota=35%
Nice=5
OOMScoreAdjust=400
TasksMax=48

[Install]
WantedBy=multi-user.target
